{
  "name": "vengeful-enforcer",
  "version": "1.0.0",
  "description": "Persistent multi-server Discord moderation",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "register-commands": "tsx src/commands/register.ts",
    "deploy": "npm run prisma:migrate && npm run build && npm run register-commands",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "check": "prisma validate && tsc --noEmit && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eclipsay/vengefulenforcer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "prisma": "6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/eclipsay/vengefulenforcer/issues"
  },
  "homepage": "https://github.com/eclipsay/vengefulenforcer#readme"
}
